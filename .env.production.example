# =============================================================================
# Finora AI — PRODUCTION credentials template
# Copy to a secret store / CI vars / docker secrets. NEVER commit filled values.
# Generate secrets:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# =============================================================================

NODE_ENV=production
PORT=4000

# Public SPA origin(s), comma-separated if needed
# Same-origin nginx deploy: http://your-domain.com
# Split hosting: https://app.example.com
FRONTEND_URL=https://app.example.com

# Managed MongoDB (Atlas or self-hosted). Not localhost in production.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER/finora_ai?retryWrites=true&w=majority

# Strong, unique secrets (≥32 chars). Access ≠ Refresh.
JWT_SECRET=REPLACE_WITH_64_CHAR_HEX_ACCESS_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_64_CHAR_HEX_REFRESH_SECRET
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Required for HTTPS production cookies (SameSite=None)
COOKIE_SECURE=true

# OpenAI — leave empty to keep mock provider
OPENAI_API_KEY=sk-REPLACE_ME
OPENAI_MODEL=gpt-4o-mini

LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_MAX=30
