# =============================================================================
# Finora AI — local development credentials (DO NOT put real production secrets)
# Copy:  cp .env.example .env
# =============================================================================

NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:4200

# MongoDB (local or Atlas connection string)
MONGODB_URI=mongodb://127.0.0.1:27017/finora_ai

# JWT — min 32 characters each; generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=finora_dev_access_secret_change_me_32chars
JWT_REFRESH_SECRET=finora_dev_refresh_secret_change_me_32ch
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# OpenAI (optional — mock AI used when empty)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Security / ops
COOKIE_SECURE=false
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=20
